{
  "name": "helloasso-mcp",
  "version": "0.1.0",
  "description": "Read-only MCP server (stdio) for the HelloAsso API v5",
  "type": "module",
  "license": "MIT",
  "bin": {
    "helloasso-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/index.js",
    "prepare": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "smoke": "node scripts/smoke-tools-list.mjs"
  },
  "keywords": [
    "mcp",
    "helloasso",
    "model-context-protocol",
    "association"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "~5.9",
    "vitest": "^4.1.12"
  },
  "author": "Nico MASSART",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NicolasMassart/helloasso-mcp.git"
  },
  "homepage": "https://github.com/NicolasMassart/helloasso-mcp#readme"
}
